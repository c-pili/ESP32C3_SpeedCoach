# ESP-IDF build output
/build/
/cmake-build-*/

# Local IDE state and machine-specific configuration
/.idea/
/.vscode/
/eim_config.toml
*.log
.DS_Store
.cache/

# Python-generated cache files
__pycache__/
*.py[cod]

# Local ESP-IDF configuration
/sdkconfig
/sdkconfig.*
!/sdkconfig.defaults
/sdkconfig.old

# Components downloaded by the ESP-IDF component manager
/managed_components/

# Generated filesystem image
/storage_image/*
!/storage_image/.gitkeep
