CONFIG_IDF_TARGET="esp32c3"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Live-screen captions. Primary/secondary numbers come from custom tabular fonts.
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_20=y

# Keep a few built-in sizes for menus/settings until size-components says they are unused.
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_32=y
CONFIG_LV_FONT_MONTSERRAT_36=y
CONFIG_LV_FONT_MONTSERRAT_40=y
CONFIG_LV_FONT_MONTSERRAT_44=y
CONFIG_LV_FONT_MONTSERRAT_48=y

CONFIG_LV_MEM_SIZE_KILOBYTES=24
CONFIG_LV_USE_SLIDER=y

# Do not compile LVGL examples/demos into the firmware (flash + missing fonts).
# CONFIG_LV_BUILD_EXAMPLES is not set
# CONFIG_LV_BUILD_DEMOS is not set

# Do not enable PSRAM merely to mask an inefficient UI.
# CONFIG_SPIRAM is not set

# NimBLE peripheral for SpeedCoach app connectivity + central for HR/RowPod sensors.
# Peripheral+central+broadcaster+observer — the coach advertises AND scans.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_CONTROLLER_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_GATT_CLIENT=y
CONFIG_BT_NIMBLE_GATT_SERVER=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=2
CONFIG_BT_NIMBLE_MAX_BONDS=2
CONFIG_BT_NIMBLE_MAX_CCCDS=4
# CONFIG_BT_NIMBLE_SECURITY_ENABLE is not set
# Leave NimBLE affinity at the ESP32-C3 single-core default.
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=23
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=2
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=3
CONFIG_BT_NIMBLE_TRANSPORT_ACL_FROM_LL_COUNT=2
CONFIG_BT_NIMBLE_TRANSPORT_EVT_COUNT=4
# Reduce BT controller log level to save RAM
CONFIG_BT_LOG_LEVEL_NONE=y
# Log level: INFO for app, WARN for system components
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_INFO=y

# BT Controller memory optimizations
CONFIG_BT_CONTROLLER_MEM_OPT=y
CONFIG_BT_CONTROLLER_RX_BUFF_NUM=2
CONFIG_BT_CONTROLLER_TX_BUFF_NUM=2
CONFIG_BT_CONTROLLER_BLE_MAX_CONN=2
CONFIG_BT_CONTROLLER_BLE_TX_BUF_NUM=2
CONFIG_BT_CONTROLLER_BLE_RX_BUF_NUM=2
CONFIG_BT_CONTROLLER_QUEUE_CONG_CHECK=y

# FAT filesystem for activity storage (supports directories unlike SPIFFS)
CONFIG_FAT_FS=y
CONFIG_FAT_FS_CODEPAGE_437=y
CONFIG_FAT_FS_CODEPAGE_850=y
CONFIG_FAT_FS_CODEPAGE_852=y
CONFIG_FAT_FS_CODEPAGE_866=y
CONFIG_FAT_FS_CODEPAGE_1252=y

# Sharp LS027B7DH01 Memory LCD pins
CONFIG_LCD_SHARP_PIN_SCLK=4
CONFIG_LCD_SHARP_PIN_MOSI=6
CONFIG_LCD_SHARP_PIN_SCS=7
CONFIG_LCD_SHARP_SPI_CLOCK_HZ=2000000

